# Template: set User, the install path and the EnvironmentFile for your host.
[Unit]
Description=Interkasten Notion Webhook Daemon
Documentation=https://github.com/mistakeknot/interkasten
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=interkasten
WorkingDirectory=/opt/interkasten
EnvironmentFile=/home/interkasten/.interkasten/.env
ExecStart=/opt/interkasten/scripts/start-webhook.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=interkasten-webhook

# Graceful shutdown
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
